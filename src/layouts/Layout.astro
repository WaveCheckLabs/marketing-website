---
import { getAbsoluteLocaleUrl } from 'astro:i18n';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { translations, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType: 'website' | 'article';
  ogTitle: string;
  ogDescription: string;
  /** 'dark' is the home page look and loads its display fonts; 'light' is used by support and the legal pages. */
  theme: 'dark' | 'light';
  bodyClass: string;
}

const { title, description, ogType, ogTitle, ogDescription, theme, bodyClass } = Astro.props;

const locale = Astro.currentLocale as Locale;
const pathWithoutLocale = Astro.routePattern.replace(/^\/pt-br/, '');
const canonicalUrl = getAbsoluteLocaleUrl(locale, pathWithoutLocale);
const ogImage = new URL('/og-image.png', Astro.site).href;

const fontFamilies = {
  dark: 'family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@500&family=Anton',
  light: 'family=Inter:wght@400;500;600;700;800',
};

const fontsUrl = `https://fonts.googleapis.com/css2?${fontFamilies[theme]}&display=swap`;
---
<!DOCTYPE html>
<html lang={translations[locale].lang} data-platform="desktop">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#000000">
  <meta name="apple-itunes-app" content="app-id=6757846707">
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl('en', pathWithoutLocale)}>
  <link rel="alternate" hreflang="pt-BR" href={getAbsoluteLocaleUrl('pt-br', pathWithoutLocale)}>
  <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', pathWithoutLocale)}>
  <link rel="icon" href="/favicon.png" type="image/png">

  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="WaveCheck">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImage}>
  <slot name="head" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href={fontsUrl} onload="this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href={fontsUrl}></noscript>

  <script is:inline>
    if (/iPhone|iPad|iPod/.test(navigator.userAgent)) {
      document.documentElement.dataset.platform = 'ios';
    } else if (/Android/.test(navigator.userAgent)) {
      document.documentElement.dataset.platform = 'android';
    }

    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body class={bodyClass}>
  <Header locale={locale} pathWithoutLocale={pathWithoutLocale} theme={theme} />
  <slot />
  <Footer locale={locale} theme={theme} />

  <script is:inline>
    document.addEventListener('click', (event) => {
      document.querySelectorAll('details[data-language-menu][open]').forEach((menu) => {
        if (!menu.contains(event.target)) {
          menu.removeAttribute('open');
        }
      });

      const storeLink = event.target.closest('a[data-store]');

      if (storeLink !== null) {
        window.va('event', { name: 'Store click', data: { store: storeLink.dataset.store, placement: storeLink.dataset.placement, locale: document.documentElement.lang } });
      }
    });
  </script>
</body>
</html>
