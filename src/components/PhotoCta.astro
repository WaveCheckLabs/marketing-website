---
import { Image } from 'astro:assets';

import piha from '../assets/photos/piha.jpg';
import StoreButtons from './StoreButtons.astro';
---
<section class="relative py-28 sm:py-40 overflow-hidden text-center">
  <Image src={piha} alt="" widths={[640, 1280, 2000]} sizes="100vw" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-[linear-gradient(to_bottom,var(--color-page)_0%,transparent_45%,color-mix(in_srgb,var(--color-page)_80%,transparent)_80%,var(--color-page)_100%)]"></div>
  <div class="relative max-w-4xl mx-auto px-6">
    <h2 class="font-condensed uppercase text-6xl sm:text-8xl leading-[0.85]">
      <slot name="title" />
    </h2>
    <p class="mt-6 text-lg max-w-lg mx-auto">
      <slot name="text" />
    </p>
    <StoreButtons placement="cta" class="mt-10 justify-center" />
  </div>
</section>
