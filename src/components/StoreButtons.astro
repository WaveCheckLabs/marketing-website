---
import { Image } from 'astro:assets';

import appleIcon from '../assets/stores/apple.png';
import googlePlayIcon from '../assets/stores/google-play.png';
import { translations, type Locale } from '../i18n';
import { appStoreUrl, playStoreUrl } from '../stores';

interface Props {
  /** Where the pair sits on the page, sent with the click event. 'hero' loads its icons eagerly. */
  placement: 'hero' | 'cta';
  class?: string;
}

const { placement, class: className } = Astro.props;

const t = translations[Astro.currentLocale as Locale].common;

const appStore = { id: 'app-store', href: appStoreUrl, icon: appleIcon, caption: t.appStore, name: 'App Store' };
const googlePlay = { id: 'google-play', href: playStoreUrl(placement), icon: googlePlayIcon, caption: t.playStore, name: 'Google Play' };

const buttons = [
  { ...appStore, style: 'inline-flex in-data-[platform=android]:hidden bg-white text-black hover:bg-primary-100' },
  { ...googlePlay, style: 'hidden in-data-[platform=android]:inline-flex bg-white text-black hover:bg-primary-100' },
  { ...googlePlay, style: 'hidden in-data-[platform=desktop]:inline-flex text-white ring-1 ring-white/25 hover:bg-white/10' },
];
---
<div class:list={['flex flex-col sm:flex-row items-center gap-3', className]}>
  {buttons.map((button) => (
    <a href={button.href} data-store={button.id} data-placement={placement} class:list={['items-center justify-center gap-3 w-full max-w-xs sm:w-auto sm:min-w-[13rem] px-6 py-3.5 rounded-2xl font-semibold transition', button.style]}>
      <Image src={button.icon} alt="" width={24} densities={[1, 2, 3]} loading={placement === 'hero' ? 'eager' : 'lazy'} class="w-6 h-6" />
      <span class="text-left leading-tight">
        <span class="block text-[10px] font-medium tracking-wide">{button.caption}</span>
        <span class="block text-base font-bold">{button.name}</span>
      </span>
    </a>
  ))}
</div>
