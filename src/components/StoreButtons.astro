---
import { Image } from 'astro:assets';

import appleIcon from '../assets/stores/apple.png';
import googlePlayIcon from '../assets/stores/google-play.png';
import { translations, type Locale } from '../i18n';
import { appStoreUrl, playStoreUrl } from '../stores';

interface Props {
  /** Where the pair sits on the page, sent with the click event. 'hero' loads its icons eagerly. */
  placement: 'hero' | 'cta';
  class?: string;
}

const { placement, class: className } = Astro.props;

const t = translations[Astro.currentLocale as Locale];
const iconLoading = placement === 'hero' ? 'eager' : 'lazy';

const button = 'items-center justify-center gap-3 w-full max-w-xs sm:w-auto sm:min-w-[13rem] px-6 py-3.5 rounded-2xl font-semibold transition';
const primary = 'bg-white text-black hover:bg-primary-100';
const secondary = 'text-white ring-1 ring-white/25 hover:bg-white/10';

const playButtons = [
  { visibility: 'hidden in-data-[platform=android]:inline-flex', style: primary },
  { visibility: 'hidden in-data-[platform=desktop]:inline-flex', style: secondary },
];
---
<div class:list={['flex flex-col sm:flex-row items-center gap-3', className]}>
  <a href={appStoreUrl} data-store="app-store" data-placement={placement} class:list={[button, primary, 'inline-flex in-data-[platform=android]:hidden']}>
    <Image src={appleIcon} alt="" width={24} densities={[1, 2, 3]} loading={iconLoading} class="w-6 h-6" />
    <span class="text-left leading-tight">
      <span class="block text-[10px] font-medium tracking-wide">{t.appStore}</span>
      <span class="block text-base font-bold">App Store</span>
    </span>
  </a>

  {playButtons.map(({ visibility, style }) => (
    <a href={playStoreUrl(placement)} data-store="google-play" data-placement={placement} class:list={[button, style, visibility]}>
      <Image src={googlePlayIcon} alt="" width={24} densities={[1, 2, 3]} loading={iconLoading} class="w-6 h-6" />
      <span class="text-left leading-tight">
        <span class="block text-[10px] font-medium tracking-wide">{t.playStore}</span>
        <span class="block text-base font-bold">Google Play</span>
      </span>
    </a>
  ))}
</div>
