---
import { Image } from 'astro:assets';

import appleIcon from '../assets/stores/apple.png';
import googlePlayIcon from '../assets/stores/google-play.png';
import { translations, type Locale } from '../i18n';

interface Props {
  /** 'hero' is the pair at the top of the home page; 'cta' is the slightly larger pair at the bottom. */
  size: 'hero' | 'cta';
}

const { size } = Astro.props;

const t = translations[Astro.currentLocale as Locale];
const iconLoading = size === 'hero' ? 'eager' : 'lazy';
const sizeClass = size === 'hero' ? 'sm:min-w-[14rem] px-6 py-3.5' : 'sm:min-w-[15rem] px-7 py-4';
const buttonClass = `inline-flex items-center justify-center gap-3 w-full max-w-xs sm:w-auto ${sizeClass} rounded-2xl font-semibold transition`;
---
<div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
  <a href="https://apps.apple.com/au/app/wavecheck/id6757846707" class={`${buttonClass} bg-white text-black hover:bg-primary-100 shadow-lg shadow-white/10`}>
    <Image src={appleIcon} alt="" width={24} densities={[1, 2, 3]} loading={iconLoading} class="w-6 h-6" />
    <span class="text-left leading-tight">
      <span class="block text-[10px] font-medium opacity-70 tracking-wide">{t.appStore}</span>
      <span class="block text-base font-bold">App Store</span>
    </span>
  </a>

  <a href="https://play.google.com/store/apps/details?id=com.viniciusdias.wavecheck" class={`${buttonClass} bg-primary-800 text-white hover:bg-primary-700`}>
    <Image src={googlePlayIcon} alt="" width={24} densities={[1, 2, 3]} loading={iconLoading} class="w-6 h-6" />
    <span class="text-left leading-tight">
      <span class="block text-[10px] font-medium opacity-70 tracking-wide">{t.playStore}</span>
      <span class="block text-base font-bold">Google Play</span>
    </span>
  </a>
</div>
