---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={[320, 640]}
  sizes="(min-width: 640px) 280px, 240px"
  pictureAttributes={{ class: 'block w-full h-full' }}
  class="block w-full h-full object-cover rounded-[2.2rem]"
/>
