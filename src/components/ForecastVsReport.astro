---
import { Image } from 'astro:assets';

import barrel from '../assets/photos/barrel.jpg';
import { type Locale } from '../i18n';

const locale = Astro.currentLocale as Locale;

const copy = {
  en: {
    forecastLabel: 'Forecast model · 5am run',
    forecastSummary: 'Predicted 3-4ft · light offshore',
    forecastNote: 'A guess made hours ago, miles offshore.',
    reportLabel: 'Example report · 6 min ago',
    photoAlt: 'A surfer on a big teal wave with others waiting in the lineup',
    caption: 'Lucas · standing on the sand',
    chips: { size: '4-6ft', wind: 'Offshore', weather: 'Sunny' },
    note: 'Firing! Way bigger than forecast, clean barrels on the bank',
    hour: (hour: number) => {
      const suffix = hour < 12 ? 'am' : 'pm';

      return `${hour > 12 ? hour - 12 : hour}${suffix}`;
    },
    height: (feet: number) => {
      return String(feet);
    },
  },
  'pt-br': {
    forecastLabel: 'Modelo de previsão · rodada das 5h',
    forecastSummary: 'Previsto 1-1,2m · terral fraco',
    forecastNote: 'Um palpite feito horas atrás, longe da costa.',
    reportLabel: 'Report de exemplo · há 6 min',
    photoAlt: 'Um surfista numa onda grande e verde, com outros esperando no line-up',
    caption: 'Lucas · direto da areia',
    chips: { size: '1,2-1,8m', wind: 'Terral', weather: 'Ensolarado' },
    note: 'Tá clássico! Bem maior que a previsão, tubos limpos no banco de areia',
    hour: (hour: number) => {
      return `${hour}h`;
    },
    height: (feet: number) => {
      return (feet * 0.3048).toLocaleString('pt-BR', { maximumFractionDigits: 1 });
    },
  },
}[locale];

const forecast = [
  { hour: 5, feet: 2.5 }, { hour: 6, feet: 3 }, { hour: 7, feet: 3.5 }, { hour: 8, feet: 4 },
  { hour: 9, feet: 4 }, { hour: 10, feet: 3.5 }, { hour: 11, feet: 3 }, { hour: 12, feet: 3 },
  { hour: 13, feet: 2.5 }, { hour: 14, feet: 2.5 }, { hour: 15, feet: 3 }, { hour: 16, feet: 3.5 },
];

const maxFeet = 8;

const rating = (5).toLocaleString(locale, { minimumFractionDigits: 1 });

const chip = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-xs font-semibold';
const icon = 'w-3 h-3 shrink-0';
---
<section class="border-y border-white/10 bg-white/[0.02]">
  <div class="max-w-6xl mx-auto px-6 py-20 sm:py-28">
    <h2 class="font-display text-4xl sm:text-6xl font-bold tracking-tight text-center">
      <slot name="title" />
    </h2>

    <div class="mt-14 grid lg:grid-cols-2 gap-6">
      <div class="rounded-3xl ring-1 ring-white/10 p-6 flex flex-col">
        <p class="font-mono text-xs uppercase tracking-widest">{copy.forecastLabel}</p>

        <div class="mt-6 flex-1 min-h-64 flex items-end gap-1.5" aria-hidden="true">
          {forecast.map(({ hour, feet }) => (
            <div class="flex-1 h-full flex flex-col justify-end items-center gap-2">
              <span class="font-mono text-[10px]">{copy.height(feet)}</span>
              <div class="w-full rounded-t-md bg-neutral-600" style={`height: ${(feet / maxFeet) * 100}%`}></div>
              <span class="font-mono text-[10px] [writing-mode:vertical-rl] sm:[writing-mode:horizontal-tb]">{copy.hour(hour)}</span>
            </div>
          ))}
        </div>

        <p class="mt-4 font-mono">{copy.forecastSummary}</p>
        <p class="mt-1 text-sm">{copy.forecastNote}</p>
      </div>

      <div class="rounded-3xl ring-1 ring-white/30 bg-white/[0.04] p-6 flex flex-col">
        <p class="font-mono text-xs uppercase tracking-widest flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>{copy.reportLabel}
        </p>

        <div class="mt-6 relative flex-1 min-h-64 rounded-2xl overflow-hidden">
          <Image src={barrel} alt={copy.photoAlt} widths={[400, 800, 1200]} sizes="(min-width: 1152px) 504px, (min-width: 1024px) calc(50vw - 72px), calc(100vw - 96px)" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
            <p class="font-semibold">Duranbah</p>
            <p class="font-mono text-xs">{copy.caption}</p>
          </div>
        </div>

        <div class="mt-6">
          <div class="flex flex-wrap items-center gap-2">
            <span class:list={[chip, 'bg-blue-100 text-blue-700']}>
              <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 3s-6 6.6-6 11a6 6 0 0 0 12 0c0-4.4-6-11-6-11z"/></svg>
              {copy.chips.size}
            </span>

            <span class:list={[chip, 'bg-green-100 text-green-700']}>
              <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4M5 4h11l-2.5 4.5L16 13H5"/></svg>
              {copy.chips.wind}
            </span>

            <span class:list={[chip, 'bg-amber-100 text-amber-700']}>
              <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              {copy.chips.weather}
            </span>

            <span class:list={[chip, 'bg-green-100 text-green-700']}>
              <svg class={icon} viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
              {rating}
            </span>
          </div>

          <p class="mt-3">{copy.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>
