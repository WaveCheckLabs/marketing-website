---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';

import logoBlack from '../assets/logos/black.png';
import logoWhite from '../assets/logos/white.png';
import { translations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  theme: 'dark' | 'light';
}

const { locale, theme } = Astro.props;

const t = translations[locale];

const links = [
  { path: '/support', label: t.support },
  { path: '/privacy', label: t.privacy },
  { path: '/terms', label: t.terms },
  { path: '/delete-account', label: t.deleteAccount },
];

const styles = {
  dark: {
    footer: 'border-white/10',
    logo: logoWhite,
    link: 'hover:text-accent transition',
    instagram: 'border-white/15 hover:text-accent hover:border-accent',
    divider: 'border-white/5',
    credit: 'decoration-white/40 hover:text-accent hover:decoration-accent',
  },
  light: {
    footer: 'border-primary-100 bg-white text-primary-900',
    logo: logoBlack,
    link: 'underline-offset-4 hover:underline',
    instagram: 'border-primary-200 hover:border-primary-900',
    divider: 'border-primary-100',
    credit: 'decoration-primary-300 hover:decoration-primary-900',
  },
}[theme];
---
<footer class:list={['border-t', styles.footer]}>
  <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-8 sm:flex sm:gap-6">
    <div class="flex items-center gap-3">
      <Image src={styles.logo} alt="WaveCheck" width={28} densities={[1, 2, 3]} class="h-7 w-auto" />
      <div>
        <p class="font-bold">WaveCheck</p>
        <p class="text-xs">{t.tagline}</p>
      </div>
    </div>

    <nav class="col-span-2 order-last grid grid-cols-2 gap-x-6 text-sm sm:order-none sm:ml-auto sm:flex sm:flex-wrap">
      {links.map((link) => <a href={getRelativeLocaleUrl(locale, link.path)} class:list={['py-2 sm:py-0', styles.link]}>{link.label}</a>)}
      <a href="mailto:support@wavecheck.app" class:list={['col-span-2 py-2 sm:py-0', styles.link]}>support@wavecheck.app</a>
    </nav>

    <a href="https://www.instagram.com/wavecheck.au/" target="_blank" rel="noopener" aria-label={t.instagram} class:list={['shrink-0 rounded-full border p-2.5 transition', styles.instagram]}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
      </svg>
    </a>
  </div>

  <div class:list={['border-t', styles.divider]}>
    <div class="max-w-6xl mx-auto px-6 py-5 text-xs">
      &copy; 2026 <a href="https://viniciusteixeiradias.github.io/" target="_blank" rel="noopener" class:list={['underline underline-offset-2 transition', styles.credit]}>Vinicius Teixeira Dias</a>. {t.rights}
    </div>
  </div>
</footer>
