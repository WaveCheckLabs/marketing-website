---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';

import logoBlack from '../assets/logos/black.png';
import logoWhite from '../assets/logos/white.png';
import { translations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  theme: 'dark' | 'light';
}

const { locale, theme } = Astro.props;

const t = translations[locale];
const dark = theme === 'dark';

const links = [
  { path: '/support', label: t.support },
  { path: '/privacy', label: t.privacy },
  { path: '/terms', label: t.terms },
  { path: '/delete-account', label: t.deleteAccount },
];

const linkClass = dark ? 'hover:text-white transition' : 'hover:text-primary-900 transition';
---
{dark ? (
  <footer class="border-t border-white/10 bg-black">
    <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col sm:flex-row gap-8 sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <Image src={logoWhite} alt="WaveCheck" width={28} densities={[1, 2, 3]} class="h-7 w-auto" />
        <div>
          <p class="font-bold">WaveCheck</p>
          <p class="text-xs text-primary-500">{t.tagline}</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-6">
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-primary-400">
          {links.map((link) => <a href={getRelativeLocaleUrl(locale, link.path)} class={linkClass}>{link.label}</a>)}
          <a href="mailto:support@wavecheck.app" class={linkClass}>support@wavecheck.app</a>
        </nav>

        <a href="https://www.instagram.com/wavecheck.au/" target="_blank" rel="noopener" aria-label={t.instagram} class="shrink-0 self-start sm:self-auto rounded-full border border-white/15 p-2.5 text-primary-400 hover:text-white hover:border-white/40 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>

    <div class="border-t border-white/5">
      <div class="max-w-6xl mx-auto px-6 py-5 text-xs text-primary-500">
        &copy; 2026 <a href="https://viniciusteixeiradias.github.io/" target="_blank" rel="noopener" class="text-primary-300 underline underline-offset-2 decoration-primary-600 hover:text-white hover:decoration-white transition">Vinicius Teixeira Dias</a>. {t.rights}
      </div>
    </div>
  </footer>
) : (
  <footer class="border-t border-primary-100 bg-white">
    <div class="max-w-5xl mx-auto px-6 py-10 flex flex-col sm:flex-row gap-6 sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <Image src={logoBlack} alt="WaveCheck" width={24} densities={[1, 2, 3]} class="h-6 w-auto" />
        <p class="text-sm text-primary-500">&copy; 2026 Vinicius Teixeira Dias. {t.rights}</p>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-6">
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-primary-500">
          {links.map((link) => <a href={getRelativeLocaleUrl(locale, link.path)} class={linkClass}>{link.label}</a>)}
        </nav>

        <a href="https://www.instagram.com/wavecheck.au/" target="_blank" rel="noopener" aria-label={t.instagram} class="shrink-0 self-start sm:self-auto rounded-full border border-primary-200 p-2.5 text-primary-500 hover:text-primary-900 hover:border-primary-400 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>
  </footer>
)}
