---
import { Image } from 'astro:assets';

import appIcon from '../assets/app-icon.png';
import appleIcon from '../assets/stores/apple.png';
import googlePlayIcon from '../assets/stores/google-play.png';
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WaveCheck — Opening surf report</title>
  <meta name="description" content="Opening this surf report in the WaveCheck app.">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="https://wavecheck.app/share/">
  <link rel="icon" href="/favicon.png" type="image/png">

  <meta name="robots" content="noindex">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="WaveCheck">
  <meta property="og:title" content="WaveCheck — Live surf reports from local surfers">
  <meta property="og:description" content="Real-time surf conditions posted by the community. Wave size, wind, weather — straight from surfers in the water.">
  <meta property="og:image" content="https://wavecheck.app/og-image.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style is:inline>
    @keyframes pulse-ring { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(1.5); opacity: 0; } }
    .pulse-ring::after { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 1.5rem; border: 2px solid #f59e0b; animation: pulse-ring 1.6s ease-out infinite; }
  </style>
  <script is:inline>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body class="bg-black text-white min-h-screen flex flex-col">
  <main class="flex-1 flex items-center justify-center px-6 py-12">
    <div class="max-w-md w-full text-center">
      <div class="relative isolate inline-flex w-20 h-20 mb-6 pulse-ring">
        <Image src={appIcon} alt="WaveCheck" width={80} densities={[1, 2, 3]} loading="eager" class="w-20 h-20 rounded-3xl" />
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Opening WaveCheck&hellip;</h1>
      <p class="mt-3 text-primary-400 text-base leading-relaxed">If the app doesn't open automatically, download it below.</p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="https://apps.apple.com/au/app/wavecheck/id6757846707" class="inline-flex items-center justify-center gap-3 w-full max-w-xs sm:w-auto sm:min-w-[14rem] px-6 py-3.5 rounded-2xl bg-white text-black font-semibold hover:bg-primary-100 transition shadow-lg shadow-white/10">
          <Image src={appleIcon} alt="" width={24} densities={[1, 2, 3]} loading="eager" class="w-6 h-6" />
          <span class="text-left leading-tight">
            <span class="block text-[10px] font-medium opacity-70 tracking-wide">Download on the</span>
            <span class="block text-base font-bold">App Store</span>
          </span>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.viniciusdias.wavecheck" class="inline-flex items-center justify-center gap-3 w-full max-w-xs sm:w-auto sm:min-w-[14rem] px-6 py-3.5 rounded-2xl bg-primary-800 text-white font-semibold hover:bg-primary-700 transition">
          <Image src={googlePlayIcon} alt="" width={24} densities={[1, 2, 3]} loading="eager" class="w-6 h-6" />
          <span class="text-left leading-tight">
            <span class="block text-[10px] font-medium opacity-70 uppercase tracking-wider">Get it on</span>
            <span class="block text-base font-bold">Google Play</span>
          </span>
        </a>
      </div>

      <p class="mt-12 text-xs text-primary-600">
        <a href="/" class="underline hover:text-primary-400">Back to wavecheck.app</a>
      </p>
    </div>
  </main>

  <script is:inline>
    var APP_STORE_URL = "https://apps.apple.com/au/app/wavecheck/id6757846707";
    var PLAY_STORE_URL = "https://play.google.com/store/apps/details?id=com.viniciusdias.wavecheck";
    var storeUrl = /android/i.test(navigator.userAgent) ? PLAY_STORE_URL : APP_STORE_URL;

    var segments = window.location.pathname.split("/").filter(Boolean);
    var postId = segments[0] === "share" ? segments[1] : null;

    if (postId) {
      var deepLink = "wavecheck://post/" + encodeURIComponent(postId);
      window.location.href = deepLink;

      setTimeout(function () {
        if (!document.hidden) {
          window.location.href = storeUrl;
        }
      }, 1500);
    }
  </script>
</body>
</html>
