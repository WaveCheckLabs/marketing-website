---
import CoastSection from '../../components/CoastSection.astro';
import ForecastVsReport from '../../components/ForecastVsReport.astro';
import LiveFeed from '../../components/LiveFeed.astro';
import PhotoCta from '../../components/PhotoCta.astro';
import StickyDownloadBar from '../../components/StickyDownloadBar.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import Layout from '../../layouts/Layout.astro';

const ogImage = new URL('/og-image.png', Astro.site).href;
const ogTitle = 'WaveCheck | Reports de surf ao vivo, direto dos surfistas locais';
const ogDescription = 'Reports de surf ao vivo, postados pela comunidade. Vídeo real, tamanho das ondas e vento do seu pico.';
const ogImageAlt = 'WaveCheck, reports de surf ao vivo';
---
<Layout
  title="WaveCheck | Baixe agora"
  description="O jeito mais rápido de saber como está o mar agora. Reports ao vivo de surfistas no pico, com vídeo real, tamanho real das ondas e vento real."
  ogType="website"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  theme="dark"
  bodyClass="bg-page text-white pb-28 sm:pb-0"
>
  <Fragment slot="head">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={ogImageAlt}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={ogImageAlt}>
  </Fragment>

  <section class="max-w-6xl mx-auto px-6 pt-8 pb-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="font-condensed uppercase text-[2.5rem] sm:text-7xl leading-[0.9]"><span class="text-accent">Como está o mar</span><br>agora?</h1>
      <p class="mt-6 text-lg max-w-md leading-relaxed">Reports de surf ao vivo, direto de surfistas no pico, postados há poucos minutos. Vídeo real, tamanho real, vento real. Sem modelos de previsão.</p>
      <StoreButtons placement="hero" class="mt-10" />
    </div>

    <LiveFeed />
  </section>

  <ForecastVsReport>
    <Fragment slot="title"><span class="text-accent">A previsão chuta</span><br>O surfista sabe.</Fragment>
  </ForecastVsReport>

  <CoastSection />

  <PhotoCta>
    <Fragment slot="title"><span class="text-accent">Pare de chutar.</span><br>Vá surfar.</Fragment>
    <Fragment slot="text">Condições reais do seu pico, postadas há poucos minutos.</Fragment>
  </PhotoCta>

  <StickyDownloadBar />
</Layout>
