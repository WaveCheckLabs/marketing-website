---
import feed from '../../assets/screenshots/feed.png';
import post from '../../assets/screenshots/post.png';
import profile from '../../assets/screenshots/profile.png';
import Screenshot from '../../components/Screenshot.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import Layout from '../../layouts/Layout.astro';

const ogImage = new URL('/og-image.png', Astro.site).href;
---
<Layout
  title="WaveCheck | Baixe agora"
  description="O jeito mais rápido de saber como está o mar agora — direto de quem está no pico. Fotos reais, tamanho real das ondas, vento real. Postado por surfistas de verdade."
  ogType="website"
  ogTitle="WaveCheck — Reports de surf ao vivo, direto dos surfistas locais"
  ogDescription="Condições do mar em tempo real, postadas pela comunidade. Tamanho das ondas, vento, clima — direto de quem está na água."
  theme="dark"
  bodyClass="bg-black text-white"
>
  <Fragment slot="head">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="WaveCheck — Reports de surf ao vivo">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="WaveCheck — Reports de surf ao vivo, direto dos surfistas locais">
    <meta name="twitter:description" content="Condições do mar em tempo real, postadas pela comunidade. Tamanho das ondas, vento, clima — direto de quem está na água.">
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content="WaveCheck — Reports de surf ao vivo">
  </Fragment>

  <section class="relative overflow-hidden pt-32 pb-24 sm:pt-40 sm:pb-32">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-900 via-black to-black"></div>
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[800px] rounded-full bg-premium-500/10 blur-3xl"></div>

    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-primary-300 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-premium-400"></span>
        Reports de surf ao vivo &middot; direto do pico
      </span>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.05] sm:leading-none">
        Como está o mar <br>
        <span class="text-premium-400">agora mesmo</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-primary-300 max-w-2xl mx-auto leading-relaxed sm:leading-7">
        O WaveCheck é o jeito mais rápido de saber o que está rolando no seu pico. Fotos reais, tamanho real das ondas, vento real. Postado por surfistas de verdade, há poucos minutos.
      </p>

      <StoreButtons size="hero" />

      <p class="mt-6 text-sm text-primary-500">Grátis para baixar &middot; iOS e Android</p>
    </div>
  </section>

  <section class="relative py-20 sm:py-28 bg-primary-50 text-primary-900">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-sm font-semibold text-premium-600 uppercase tracking-wider mb-3">Um feed de condições ao vivo</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Veja exatamente o que está rolando no pico</h2>
        <p class="mt-4 text-primary-600 leading-relaxed">Chega de viagem perdida. Chega de adivinhar se o vento virou. Chega de previsão mentindo sobre o que tem lá fora.</p>
      </div>

      <div id="phoneCarousel" class="flex sm:grid sm:grid-cols-3 sm:gap-10 sm:max-w-4xl sm:mx-auto -mx-6 sm:mx-0 overflow-x-auto sm:overflow-visible snap-x snap-mandatory sm:snap-none pb-12 sm:pb-0 no-scrollbar">
        <div data-slide="0" class="snap-center shrink-0 w-full sm:w-auto sm:shrink px-6 sm:px-0">
          <div class="mx-auto max-w-[240px] sm:max-w-none rounded-[2.2rem] bg-primary-900 p-1.5 shadow-2xl shadow-primary-300/40 sm:translate-y-8 overflow-hidden">
            <Screenshot src={feed} alt="Feed do WaveCheck com reports de surf ao vivo" />
          </div>
        </div>
        <div data-slide="1" class="snap-center shrink-0 w-full sm:w-auto sm:shrink px-6 sm:px-0">
          <div class="mx-auto max-w-[240px] sm:max-w-none rounded-[2.2rem] bg-primary-900 p-1.5 shadow-2xl shadow-premium-500/30 overflow-hidden">
            <Screenshot src={post} alt="Novo report de surf com vídeo, local, tamanho das ondas e vento" />
          </div>
        </div>
        <div data-slide="2" class="snap-center shrink-0 w-full sm:w-auto sm:shrink px-6 sm:px-0">
          <div class="mx-auto max-w-[240px] sm:max-w-none rounded-[2.2rem] bg-primary-900 p-1.5 shadow-2xl shadow-primary-300/40 sm:translate-y-8 overflow-hidden">
            <Screenshot src={profile} alt="Perfil de surfista com XP, histórico de posts e estatísticas" />
          </div>
        </div>
      </div>

      <div id="phoneDots" class="flex sm:hidden justify-center gap-2 mt-6" aria-label="Navegação das capturas de tela">
        <button type="button" data-dot="0" aria-label="Mostrar a captura do feed" class="h-2 w-6 rounded-full bg-primary-900 transition-all duration-300"></button>
        <button type="button" data-dot="1" aria-label="Mostrar a captura do novo report" class="h-2 w-2 rounded-full bg-primary-300 transition-all duration-300"></button>
        <button type="button" data-dot="2" aria-label="Mostrar a captura do perfil" class="h-2 w-2 rounded-full bg-primary-300 transition-all duration-300"></button>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28 bg-black">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-14">
        <p class="text-sm font-semibold text-premium-400 uppercase tracking-wider mb-3">O que você pode fazer</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Feito para quem cai na água de verdade</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 rounded-3xl overflow-hidden">
        <div class="bg-black p-8">
          <div class="w-10 h-10 rounded-xl bg-premium-500/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-premium-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Confira antes de sair de casa</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Veja as condições ao vivo nos picos que você surfa antes de ir para a praia.</p>
        </div>

        <div class="bg-black p-8">
          <div class="w-10 h-10 rounded-xl bg-premium-500/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-premium-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Fotos e vídeos reais</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Nada de gráficos e setas. A prova real, de quem está lá agora.</p>
        </div>

        <div class="bg-black p-8">
          <div class="w-10 h-10 rounded-xl bg-premium-500/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-premium-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Publique seus próprios reports</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Compartilhe fotos, vídeos, tamanho das ondas, vento e clima em segundos.</p>
        </div>

        <div class="bg-black p-8">
          <div class="w-10 h-10 rounded-xl bg-premium-500/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-premium-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Siga surfistas em quem você confia</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Monte um feed personalizado com os surfistas cujos reports batem com a realidade.</p>
        </div>

        <div class="bg-black p-8">
          <div class="w-10 h-10 rounded-xl bg-premium-500/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-premium-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Busque qualquer pico</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Encontre qualquer pico ou surfista, em qualquer lugar do litoral.</p>
        </div>

        <div class="bg-black p-8">
          <div class="w-10 h-10 rounded-xl bg-premium-500/10 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-premium-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Ganhe XP compartilhando</h3>
          <p class="text-primary-400 text-sm leading-relaxed">Mantenha a comunidade informada e troque XP por equipamentos de surf de verdade.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28 bg-primary-900">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-sm font-semibold text-premium-400 uppercase tracking-wider mb-3">Por que os surfistas usam o WaveCheck</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Sem enrolação. Só o que está rolando.</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-white/10 bg-black/40 p-7">
          <h3 class="font-semibold text-lg mb-2 flex items-center gap-2">
            <span class="text-premium-400">&rarr;</span> Reports reais, em tempo real
          </h3>
          <p class="text-primary-400 text-sm leading-relaxed">Todo post tem hora e pico. Se não está acontecendo agora, não está no feed.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/40 p-7">
          <h3 class="font-semibold text-lg mb-2 flex items-center gap-2">
            <span class="text-premium-400">&rarr;</span> Prova em foto e vídeo
          </h3>
          <p class="text-primary-400 text-sm leading-relaxed">Números num gráfico podem mentir. Uma foto de uma esquerda de um metro abrindo no seu pico, não.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/40 p-7">
          <h3 class="font-semibold text-lg mb-2 flex items-center gap-2">
            <span class="text-premium-400">&rarr;</span> Tamanho que dá pra confiar
          </h3>
          <p class="text-primary-400 text-sm leading-relaxed">Câmeras achatam as ondas e previsões só preveem. Um report do WaveCheck vem de quem remou até o outside. O tamanho informado é o que a pessoa realmente surfou.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/40 p-7">
          <h3 class="font-semibold text-lg mb-2 flex items-center gap-2">
            <span class="text-premium-400">&rarr;</span> Um line-up de confiança
          </h3>
          <p class="text-primary-400 text-sm leading-relaxed">Siga os surfistas cujos reports batem com o que você encontra quando cai na água.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/40 p-7">
          <h3 class="font-semibold text-lg mb-2 flex items-center gap-2">
            <span class="text-premium-400">&rarr;</span> Feito por surfistas, para surfistas
          </h3>
          <p class="text-primary-400 text-sm leading-relaxed">Sem ruído, sem anúncios, sem algoritmo adivinhando o que você quer. Só surf.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 bg-black overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-primary-900 to-black"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-premium-500/5 blur-3xl"></div>

    <div class="relative max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight sm:leading-none">
        Pegue a onda perfeita.
      </h2>
      <p class="mt-5 text-lg text-primary-300 leading-relaxed max-w-xl mx-auto">
        Compartilhe reports de surf ao vivo do seu pico, siga surfistas em quem você confia e ganhe recompensas por manter a galera informada.
      </p>
      <StoreButtons size="cta" />
    </div>
  </section>

  <script is:inline>
    (function () {
      const carousel = document.getElementById('phoneCarousel');
      const dotsRow = document.getElementById('phoneDots');

      if (carousel === null || dotsRow === null) {
        return;
      }

      const slides = carousel.querySelectorAll('[data-slide]');
      const dots = dotsRow.querySelectorAll('[data-dot]');

      const setActive = (idx) => {
        dots.forEach((dot, i) => {
          const isActive = i === idx;
          dot.classList.toggle('w-6', isActive);
          dot.classList.toggle('bg-primary-900', isActive);
          dot.classList.toggle('w-2', !isActive);
          dot.classList.toggle('bg-primary-300', !isActive);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
              setActive(parseInt(entry.target.dataset.slide, 10));
            }
          });
        },
        { root: carousel, threshold: [0.6] }
      );

      slides.forEach((slide) => observer.observe(slide));

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          slides[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        });
      });
    })();
  </script>
</Layout>
