---
import CoastSection from '../components/CoastSection.astro';
import ForecastVsReport from '../components/ForecastVsReport.astro';
import LiveFeed from '../components/LiveFeed.astro';
import PhotoCta from '../components/PhotoCta.astro';
import StickyDownloadBar from '../components/StickyDownloadBar.astro';
import StoreButtons from '../components/StoreButtons.astro';
import Layout from '../layouts/Layout.astro';

const ogImage = new URL('/og-image.png', Astro.site).href;
const ogTitle = 'WaveCheck | Live surf reports from local surfers';
const ogDescription = 'Live surf reports posted by the community. Real video, wave size and wind from your local break.';
const ogImageAlt = 'WaveCheck live surf reports';
---
<Layout
  title="WaveCheck | Download Today"
  description="The fastest way to know what the surf is doing right now. Live reports from surfers at the break with real video, real wave size and real wind."
  ogType="website"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  theme="dark"
  bodyClass="bg-page text-white pb-28 sm:pb-0"
>
  <Fragment slot="head">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={ogImageAlt}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={ogImageAlt}>
  </Fragment>

  <section class="max-w-6xl mx-auto px-6 pt-8 pb-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="font-condensed uppercase text-5xl sm:text-7xl leading-[0.9]"><span class="text-accent">What's it doing</span><br>right now?</h1>
      <p class="mt-6 text-lg max-w-md leading-relaxed">Live surf reports from surfers at the break, posted minutes ago. Real video, real size, real wind. No forecast models.</p>
      <StoreButtons placement="hero" class="mt-10" />
    </div>

    <LiveFeed />
  </section>

  <ForecastVsReport>
    <Fragment slot="title"><span class="text-accent">Forecasts guess</span><br>Surfers know.</Fragment>
  </ForecastVsReport>

  <CoastSection />

  <PhotoCta>
    <Fragment slot="title"><span class="text-accent">Stop guessing.</span><br>Start surfing.</Fragment>
    <Fragment slot="text">Real conditions from your local, posted minutes ago.</Fragment>
  </PhotoCta>

  <StickyDownloadBar />
</Layout>
